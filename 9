#include <iostream>
using namespace std;

bool isPalindrome(int n) {
    int original = n;
    int reversed = 0;

    while (n > 0) {
        int digit = n % 10;
        reversed = reversed * 10 + digit;
        n /= 10;
    }

    return original == reversed;
}

int main() {
    int n;
    int sum = 0; 
    cin >> n;

    for (int i = 1; i <= n; i++) {
        if (isPalindrome(i)) {
            sum += i;
        }
    }

    cout << sum << endl; 
    return 0;
}
